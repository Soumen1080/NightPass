# ─── Production Environment Variables ────────────────────────────────────
# For Vercel deployment: set these in the Vercel dashboard under
# Project > Settings > Environment Variables
# For Docker: pass via --env-file .env.production.local

# ─── Database ─────────────────────────────────────────────────────────────
# Option 1: Neon DB (recommended for Vercel serverless)
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Option 2: Supabase (use the pooler URL for serverless compatibility)
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Midnight Network ─────────────────────────────────────────────────────
# Production networks: 'preprod' (for testing with real wallets) or 'preview'
NEXT_PUBLIC_NETWORK_ID="preprod"

# ─── Contract ────────────────────────────────────────────────────────────
# The deployed Midnight Preprod contract address for NightPass
NEXT_PUBLIC_CONTRACT_ADDRESS="5ee45743bda79990b937f48e78594b4d5391cc4a15b27dc997d3591972ac6a24"
