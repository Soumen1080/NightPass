# ─── Production Environment Variables ────────────────────────────────────
# Copy this file to .env.production.local and fill in your real values.

# Neon DB connection string for Prisma (required)
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Midnight Network Configuration
# Use 'preprod' or 'preview'
NEXT_PUBLIC_NETWORK_ID="preprod"

# Optional: Hardcode a specific party contract address for all users.
# Leave blank to allow dynamic input in the UI.
NEXT_PUBLIC_CONTRACT_ADDRESS=""
