generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Party {
  id               String    @id @default(uuid())
  contractAddress  String    @unique
  organizerAddress String
  name             String
  description      String?
  entryFee         Float     @default(0)
  maxGuests        Int       @default(100)
  deadline         DateTime?
  txHash           String?
  network          String    @default("preprod")
  status           String    @default("READY") // READY, STARTED, CLOSED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  rsvps            RSVP[]
  feedback         Feedback[]
}

model RSVP {
  id              String   @id @default(uuid())
  partyId         String
  party           Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  attendeeAddress String
  commitmentHash  String   // The hash of the commitment submitted to the contract
  attendeeName    String?  // Optional off-chain friendly name
  checkedIn       Boolean  @default(false)
  txHash          String?
  checkInTxHash   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([partyId, commitmentHash])
}

model Feedback {
  id              String   @id @default(uuid())
  partyId         String?
  party           Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  walletAddress   String?
  rating          Int      // 1-5
  category        String   // UX, Wallet, Contract, Privacy, Docs, Feature
  message         String
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())
}
