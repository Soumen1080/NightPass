# ─── NightPass Environment Variables ─────────────────────────────────────
# Copy this file to .env.local and fill in your real values.

# Neon DB connection string for Prisma (required)
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Midnight Network Configuration
# Supported values: 'preprod' or 'preview'
# IMPORTANT: This value is used for BOTH the network config URLs AND the
# crypto network ID.  They must match or wallet operations will fail.
NEXT_PUBLIC_NETWORK_ID="preprod"

# Optional: The address of a specific deployed contract.
# If set, the join and organize pages will prefill this contract address.
# Leave blank to allow users to input the contract address dynamically in the UI.
NEXT_PUBLIC_CONTRACT_ADDRESS=""
