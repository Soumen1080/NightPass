# ─── NightPass Environment Variables ─────────────────────────────────────
# Copy this file to .env.local and fill in your real values.

# ─── Database (Choose ONE: Neon DB or Supabase) ───────────────────────────
# Option 1: Neon DB (recommended for serverless)
# DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Option 2: Supabase
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/database
# DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Required: Set this to one of the above DATABASE_URL values
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# ─── Optional: Supabase API Keys (if using Supabase JS client) ────────────
# Get from: https://supabase.com/dashboard/project/<your-project>/settings/api
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-key>"

# ─── Midnight Network Configuration ──────────────────────────────────────
# Supported values: 'preprod' or 'preview'
# IMPORTANT: This value is used for BOTH the network config URLs AND the
# crypto network ID.  They must match or wallet operations will fail.
NEXT_PUBLIC_NETWORK_ID="preprod"

# ─── Contract Configuration ───────────────────────────────────────────────
# Optional: The address of a specific deployed contract.
# If set, the join and organize pages will prefill this contract address.
# Leave blank to allow users to input the contract address dynamically in the UI.
NEXT_PUBLIC_CONTRACT_ADDRESS=""

# ─── Example Preprod Contract ─────────────────────────────────────────────
# Our deployed Preprod contract (for reference / testing):
# NEXT_PUBLIC_CONTRACT_ADDRESS="5ee45743bda79990b937f48e78594b4d5391cc4a15b27dc997d3591972ac6a24"
